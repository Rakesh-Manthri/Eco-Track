# ==============================================================
# Eco-Track Database Configuration Template
# Copy this file to 'db.properties' and fill in your credentials.
# 'db.properties' is gitignored to protect your credentials.
# ==============================================================

# For Aiven for MySQL:
# 1. Sign up at https://aiven.io (free trial available)
# 2. Create a "MySQL" service
# 3. Copy the "Service URI" or connection parameters from the Overview tab
DB_HOST=mysql-xxxx-your-project.aivencloud.com
DB_PORT=12345
DB_NAME=carbon_tracker
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_SSL_MODE=REQUIRED
DB_USE_SSL=true

# (Optional) Full JDBC URL override if you prefer to paste directly:
# DB_URL=jdbc:mysql://mysql-xxxx-your-project.aivencloud.com:12345/carbon_tracker?sslMode=REQUIRED&allowPublicKeyRetrieval=true
